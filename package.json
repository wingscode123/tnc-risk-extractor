{
  "name": "lexguard-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "eval:ai": "tsx scripts/evaluate.ts",
    "lint": "tsc --noEmit",
    "format": "prettier --write src server.ts scripts tests vite.config.ts playwright.config.ts tsconfig.json package.json docs README.md .github",
    "format:check": "prettier --check src server.ts scripts tests vite.config.ts playwright.config.ts tsconfig.json package.json docs README.md .github"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "fflate": "^0.8.3",
    "helmet": "^8.0.0",
    "lru-cache": "^10.2.0",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
