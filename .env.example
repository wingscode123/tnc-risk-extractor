# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port HTTP server. Default 3000 bila tidak disetel.
PORT="3000"

# GEMINI_MODELS: Daftar model kandidat (dipisah koma, dicoba berurutan).
GEMINI_MODELS="gemini-3.8-flash,gemini-3.1-flash-lite"

# APP_URL: Origin CORS tambahan bila frontend tidak se-origin; pisahkan dengan koma.
# Biarkan kosong untuk penggunaan frontend dan API pada server yang sama.
APP_URL=""

# Jumlah proxy tepercaya. 0 untuk akses langsung; sesuaikan topologi deployment.
TRUST_PROXY_HOPS="0"
